# Local microfrontend server URLs
# Copy this file to `.env` and adjust per your local setup.
# Consumed by apps/main/next.config.js to proxy (rewrite) satellite apps in dev.
# Ports mirror repo.manifest.json; override here to point at a remote/staging host.

MAIN_MICROFRONTEND_SERVER_URL=http://localhost:3000
CONSOLE_MICROFRONTEND_SERVER_URL=http://localhost:3001
LOGIN_MICROFRONTEND_SERVER_URL=http://localhost:3002
INVENTORY_MICROFRONTEND_SERVER_URL=http://localhost:3003
ADMIN_TOOLS_MICROFRONTEND_SERVER_URL=http://localhost:3004
VINI_MICROFRONTEND_SERVER_URL=http://localhost:3005
STUDIO_MICROFRONTEND_SERVER_URL=http://localhost:3006
DOCS_MICROFRONTEND_SERVER_URL=http://localhost:3007
