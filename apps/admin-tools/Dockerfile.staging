# Staging variant: selective copy + pnpm in base, Next standalone output.
# Adapted to this repo: node:20-alpine, workspace "admin-tools", port 3004.

FROM node:20-alpine AS base
RUN npm install -g pnpm
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"

FROM base AS builder
WORKDIR /app
RUN pnpm add -g turbo@^2
COPY apps/admin-tools ./apps/admin-tools
COPY packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN turbo prune admin-tools --docker

FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
RUN pnpm install
COPY --from=builder /app/out/full/ .
COPY .env* ./

RUN pnpm turbo run build --filter=admin-tools
RUN mkdir -p apps/admin-tools/public

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3004
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=installer --chown=nextjs:nodejs /app/apps/admin-tools/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/admin-tools/.next/static ./apps/admin-tools/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/admin-tools/public ./apps/admin-tools/public
USER nextjs
EXPOSE 3004
WORKDIR /app/apps/admin-tools
CMD ["node", "server.js"]
