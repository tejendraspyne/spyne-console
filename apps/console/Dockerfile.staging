# Staging variant: selective copy + pnpm in base, Next standalone output.
# Adapted to this repo: node:20-alpine, workspace "console", port 3001.

FROM node:20-alpine AS base
RUN npm install -g pnpm
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"

FROM base AS builder
WORKDIR /app
RUN pnpm add -g turbo@^2
COPY apps/console ./apps/console
COPY packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN turbo prune console --docker

FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
RUN pnpm install
COPY --from=builder /app/out/full/ .
COPY .env* ./

RUN pnpm turbo run build --filter=console
RUN mkdir -p apps/console/public

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=installer --chown=nextjs:nodejs /app/apps/console/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/console/.next/static ./apps/console/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/console/public ./apps/console/public
USER nextjs
EXPOSE 3001
WORKDIR /app/apps/console
CMD ["node", "server.js"]
