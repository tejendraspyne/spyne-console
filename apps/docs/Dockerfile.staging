# Staging variant: selective copy + pnpm in base, Next standalone output.
# Adapted to this repo: node:20-alpine, workspace "docs", port 3007.

FROM node:20-alpine AS base
RUN npm install -g pnpm
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"

FROM base AS builder
WORKDIR /app
RUN pnpm add -g turbo@^2
COPY apps/docs ./apps/docs
COPY packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN turbo prune docs --docker

FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
RUN pnpm install
COPY --from=builder /app/out/full/ .
COPY .env* ./

RUN pnpm turbo run build --filter=docs
RUN mkdir -p apps/docs/public

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3007
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=installer --chown=nextjs:nodejs /app/apps/docs/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/docs/.next/static ./apps/docs/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/docs/public ./apps/docs/public
USER nextjs
EXPOSE 3007
WORKDIR /app/apps/docs
CMD ["node", "server.js"]
