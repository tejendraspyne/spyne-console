# Staging variant: selective copy + pnpm in base, Next standalone output.
# Adapted to this repo: node:20-alpine, workspace "inventory", port 3003.

FROM node:20-alpine AS base
RUN npm install -g pnpm
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"

FROM base AS builder
WORKDIR /app
RUN pnpm add -g turbo@^2
COPY apps/inventory ./apps/inventory
COPY packages ./packages
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN turbo prune inventory --docker

FROM base AS installer
WORKDIR /app
COPY --from=builder /app/out/json/ .
RUN pnpm install
COPY --from=builder /app/out/full/ .
COPY .env* ./

RUN pnpm turbo run build --filter=inventory
RUN mkdir -p apps/inventory/public

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3003
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=installer --chown=nextjs:nodejs /app/apps/inventory/.next/standalone ./
COPY --from=installer --chown=nextjs:nodejs /app/apps/inventory/.next/static ./apps/inventory/.next/static
COPY --from=installer --chown=nextjs:nodejs /app/apps/inventory/public ./apps/inventory/public
USER nextjs
EXPOSE 3003
WORKDIR /app/apps/inventory
CMD ["node", "server.js"]
