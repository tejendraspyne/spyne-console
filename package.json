{
  "name": "console",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",

    "dev:main": "turbo run dev --filter=main",
    "dev:console": "turbo run dev --filter=console",
    "dev:login": "turbo run dev --filter=login",
    "dev:inventory": "turbo run dev --filter=inventory",
    "dev:admin-tools": "turbo run dev --filter=admin-tools",
    "dev:vini": "turbo run dev --filter=vini",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:docs": "turbo run dev --filter=docs",
    "build:main": "turbo run build --filter=main...",
    "build:console": "turbo run build --filter=console...",
    "build:login": "turbo run build --filter=login...",
    "build:inventory": "turbo run build --filter=inventory...",
    "build:admin-tools": "turbo run build --filter=admin-tools...",
    "build:vini": "turbo run build --filter=vini...",
    "build:studio": "turbo run build --filter=studio...",
    "build:docs": "turbo run build --filter=docs...",
    "lint:main": "turbo run lint --filter=main",
    "lint:console": "turbo run lint --filter=console",
    "lint:login": "turbo run lint --filter=login",
    "lint:inventory": "turbo run lint --filter=inventory",
    "lint:admin-tools": "turbo run lint --filter=admin-tools",
    "lint:vini": "turbo run lint --filter=vini",
    "lint:studio": "turbo run lint --filter=studio",
    "lint:docs": "turbo run lint --filter=docs",
    "types:main": "turbo run check-types --filter=main",
    "types:console": "turbo run check-types --filter=console",
    "types:login": "turbo run check-types --filter=login",
    "types:inventory": "turbo run check-types --filter=inventory",
    "types:admin-tools": "turbo run check-types --filter=admin-tools",
    "types:vini": "turbo run check-types --filter=vini",
    "types:studio": "turbo run check-types --filter=studio",
    "types:docs": "turbo run check-types --filter=docs",

    "boundaries:check": "node scripts/validate-manifest.mjs && node scripts/check-scope.mjs",
    "check": "turbo run lint check-types && pnpm run boundaries:check",

    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:gateway:up": "docker compose -f docker-compose.yml -f docker-compose.gateway.yml up --build -d",
    "docker:gateway:down": "docker compose -f docker-compose.yml -f docker-compose.gateway.yml down",
    "docker:gateway:logs": "docker compose -f docker-compose.yml -f docker-compose.gateway.yml logs -f main",

    "gen:app": "turbo gen new-app",
    "gen:package": "turbo gen new-package",
    "gen:asset": "pnpm --filter @repo/assets run gen"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
